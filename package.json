{
  "name": "dotnetreport-react",
  "version": "6.4.0",
  "description": "React component for dotnetreport (report builder, dashboard, setup, users & access)",
  "keywords": [
    "dotnet report",
    "dotnetreport",
    "react report builder",
    "report builder"
  ],
  "license": "SEE LICENSE IN dotnetreport EULA/LGPL",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-templates": "node ../angular/scripts/sync-templates.mjs .. --out src/templates.generated.ts",
    "build": "npm run sync-templates && tsup",
    "demo": "npm run sync-templates && vite --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "dotnetreport": "^6.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  }
}
