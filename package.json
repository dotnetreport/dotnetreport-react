{
  "name": "dotnetreport-react",
  "version": "6.3.4",
  "description": "React component for dotnetreport (report builder, dashboard, setup)",
  "keywords": [
    "dotnet report",
    "dotnetreport",
    "react report builder",
    "report builder"
  ],
  "license": "SEE LICENSE IN dotnetreport EULA/LGPL",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-templates": "node scripts/extract-templates.mjs",
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "build": "^0.1.4"
  }
}
